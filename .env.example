APP_NAME=ShulePulse
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=shulepulse_access
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DATABASE_URL=mysql+pymysql://shulepulse:shulepulse@127.0.0.1:3306/shulepulse
ROOT_DOMAIN=shulepulse.localhost
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost,shulepulse.localhost
DEFAULT_SCHOOL_SETTINGS={"branding":{"primary_color":"#166534","secondary_color":"#facc15"},"grading":{},"reports":{"show_position":false,"show_teacher_comments":true}}
